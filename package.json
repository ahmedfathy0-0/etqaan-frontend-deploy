{
  "name": "etqaan-frontend",
  "version": "1.0.5",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "build:export": "next build",
    "start": "next start",
    "lint": "next lint",
    "electron:build": "npm run build:export && electron-builder",
    "release": "node release.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/preferences": "^8.0.1",
    "@capawesome-team/capacitor-file-opener": "^8.0.1",
    "@dga-icons/react": "^0.1.1",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-query-devtools": "^5.101.0",
    "axios": "^1.17.0",
    "electron-updater": "^6.8.9",
    "next": "^16.1.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hot-toast": "^2.6.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.21",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.11",
    "typescript": "^5"
  },
  "build": {
    "appId": "com.etqaan.rahman",
    "productName": "Rahman",
    "artifactName": "${productName}-${version}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "ahmedfathy0-0",
        "repo": "etqaan-frontend-deploy"
      }
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "public/images/logo.png"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/images/logo.png"
    },
    "mac": {
      "icon": "public/images/logo.png"
    },
    "files": [
      "out/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    }
  }
}
